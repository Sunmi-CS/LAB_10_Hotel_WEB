
@{
    ViewData["Title"] = "Privacidad";
}

<div class="container py-4">

    <div class="p-5 mb-4 rounded-4 text-white shadow"
         style="background: linear-gradient(135deg, #142d4e, #285b78);">

        <span class="badge bg-light text-dark mb-3">
            HOTEL.WEB
        </span>

        <h1 class="display-5 fw-bold">
            Política de privacidad
        </h1>

        <p class="lead mb-0">
            Protegemos la información de nuestros huéspedes
            y gestionamos sus datos de manera responsable.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="fs-1 mb-3">🔒</div>
                    <h2 class="h5 fw-bold">Protección de datos</h2>
                    <p class="text-muted mb-0">
                        La información de huéspedes y reservas debe ser
                        accesible únicamente para personas autorizadas.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="fs-1 mb-3">📋</div>
                    <h2 class="h5 fw-bold">Uso de la información</h2>
                    <p class="text-muted mb-0">
                        Los datos registrados se utilizan para administrar
                        huéspedes, habitaciones y reservas del hotel.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="fs-1 mb-3">🛡️</div>
                    <h2 class="h5 fw-bold">Acceso responsable</h2>
                    <p class="text-muted mb-0">
                        Se recomienda proteger las credenciales de acceso
                        y evitar compartir información personal sin autorización.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4 p-md-5">

            <h2 class="h4 fw-bold mb-3">
                Información administrada
            </h2>

            <p>
                El sistema Hotel.Web permite gestionar información relacionada
                con los huéspedes, las habitaciones y las reservas.
            </p>

            <h3 class="h5 fw-semibold mt-4">Datos de los huéspedes</h3>
            <p class="text-muted">
                Incluyen datos identificativos y, cuando corresponda,
                información de contacto registrada para la administración
                de las reservas.
            </p>

            <h3 class="h5 fw-semibold mt-4">Información de las reservas</h3>
            <p class="text-muted">
                Incluye fechas de ingreso y salida, habitación asignada,
                estado de la reserva y fecha de registro.
            </p>

            <h3 class="h5 fw-semibold mt-4">Responsabilidad</h3>
            <p class="text-muted">
                Los responsables de operar el sistema deben aplicar medidas
                adecuadas para proteger la información y limitar el acceso
                a los usuarios autorizados.
            </p>

            <div class="alert alert-info mt-4 mb-0">
                <strong>Nota académica:</strong>
                esta página presenta recomendaciones generales de privacidad
                para el proyecto. No sustituye una política legal formal
                ni implica que la aplicación ya tenga autenticación,
                autorización o medidas de seguridad adicionales configuradas.
            </div>

        </div>
    </div>

    <div class="text-center text-muted mt-4">
        <small>Hotel.Web · Sistema de gestión hotelera · Semana 10</small>
    </div>

    <div class="mt-3">
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-primary">
            ← Volver al inicio
        </a>
    </div>

</div>