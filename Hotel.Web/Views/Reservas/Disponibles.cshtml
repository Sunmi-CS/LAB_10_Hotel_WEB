
@model IEnumerable<Hotel.Web.Models.Habitacion>

@{
    ViewData["Title"] = "Disponibilidad";
}

<h1>Disponibilidad de habitaciones</h1>

<form asp-action="Disponibles" method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label class="form-label" for="fechaIngreso">Fecha de ingreso</label>
        <input id="fechaIngreso"
               name="fechaIngreso"
               type="date"
               value="@ViewBag.FechaIngreso"
               class="form-control"
               required />
    </div>

    <div class="col-md-4">
        <label class="form-label" for="fechaSalida">Fecha de salida</label>
        <input id="fechaSalida"
               name="fechaSalida"
               type="date"
               value="@ViewBag.FechaSalida"
               class="form-control"
               required />
    </div>

    <div class="col-md-4 align-self-end">
        <button type="submit" class="btn btn-primary">Buscar habitaciones</button>
    </div>
</form>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

@if (ViewBag.FechaIngreso != null && ViewBag.FechaSalida != null)
{
    <p>
        <strong>Noches:</strong> @ViewBag.Noches
    </p>

    @if (Model.Any())
    {
        <table class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Piso</th>
                    <th>Tipo</th>
                    <th>Capacidad</th>
                    <th>Precio por noche</th>
                    <th>Total estimado</th>
                    <th>Acción</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var habitacion in Model)
            {
                var precio = habitacion.IdTipoHabitacionNavigation.PrecioNoche;
                var total = precio * (int)ViewBag.Noches;

                <tr>
                    <td>@habitacion.Numero</td>
                    <td>@habitacion.Piso</td>
                    <td>@habitacion.IdTipoHabitacionNavigation.Nombre</td>
                    <td>@habitacion.IdTipoHabitacionNavigation.Capacidad</td>
                    <td>S/ @precio.ToString("N2")</td>
                    <td>S/ @total.ToString("N2")</td>
                    <td>
                        <a asp-action="Create" class="btn btn-sm btn-success">
                            Registrar reserva
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
    else if (ViewBag.Noches > 0)
    {
        <div class="alert alert-warning">
            No se encontraron habitaciones disponibles para esas fechas.
        </div>
    }
}

<p>
    <a asp-action="Index" class="btn btn-secondary">Volver a reservas</a>
</p>
