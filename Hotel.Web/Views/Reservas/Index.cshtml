
@model IEnumerable<Hotel.Web.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<h1>Reservas</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-info">@mensaje</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Registrar reserva</a>
    <a asp-action="Disponibles" class="btn btn-outline-primary">Consultar disponibilidad</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Huésped</th>
            <th>Habitación</th>
            <th>Ingreso</th>
            <th>Salida</th>
            <th>Noches</th>
            <th>Total estimado</th>
            <th>Estado</th>
            <th>Acción</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var reserva in Model)
    {
        var noches = reserva.FechaSalida.DayNumber - reserva.FechaIngreso.DayNumber;
        var precioNoche = reserva.IdHabitacionNavigation
            .IdTipoHabitacionNavigation.PrecioNoche;
        var total = noches * precioNoche;

        <tr>
            <td>
                @reserva.IdHuespedNavigation.Nombres
                @reserva.IdHuespedNavigation.Apellidos
            </td>
            <td>@reserva.IdHabitacionNavigation.Numero</td>
            <td>@reserva.FechaIngreso.ToString("dd/MM/yyyy")</td>
            <td>@reserva.FechaSalida.ToString("dd/MM/yyyy")</td>
            <td>@noches</td>
            <td>S/ @total.ToString("N2")</td>
            <td>@reserva.Estado</td>
            <td>
                @if (reserva.Estado == "Pendiente" ||
                     reserva.Estado == "Confirmada")
                {
                    <form asp-action="Cancelar"
                          asp-route-id="@reserva.IdReserva"
                          method="post"
                          onsubmit="return confirm('¿Deseas cancelar esta reserva?');">
                        <button type="submit" class="btn btn-sm btn-danger">
                            Cancelar
                        </button>
                    </form>
                }
                else
                {
                    <span class="text-muted">Sin acciones</span>
                }
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Todavía no hay reservas registradas.</p>
}
