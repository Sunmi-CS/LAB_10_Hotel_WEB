
@model IEnumerable<Hotel.Web.Models.Habitacion>

@{
    ViewData["Title"] = "Habitaciones";
}

<h1>Habitaciones</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Registrar habitación</a>
</p>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <label class="form-label">Tipo de habitación</label>
        <select name="idTipoHabitacion"
                asp-items="ViewBag.IdTipoHabitacion"
                class="form-select">
            <option value="">Todos los tipos</option>
        </select>
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-secondary">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Número</th>
            <th>Piso</th>
            <th>Tipo</th>
            <th>Precio por noche</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var habitacion in Model)
    {
        <tr>
            <td>@habitacion.Numero</td>
            <td>@habitacion.Piso</td>
            <td>@habitacion.IdTipoHabitacionNavigation.Nombre</td>
            <td>@habitacion.IdTipoHabitacionNavigation.PrecioNoche.ToString("C")</td>
            <td>
                <a asp-action="Details" asp-route-id="@habitacion.IdHabitacion"
                   class="btn btn-sm btn-info">Detalles</a>
                <a asp-action="Edit" asp-route-id="@habitacion.IdHabitacion"
                   class="btn btn-sm btn-warning">Editar</a>
                <a asp-action="Delete" asp-route-id="@habitacion.IdHabitacion"
                   class="btn btn-sm btn-danger">Desactivar</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No se encontraron habitaciones activas para el filtro seleccionado.</p>
}
