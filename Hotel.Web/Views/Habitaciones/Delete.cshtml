
@model Hotel.Web.Models.Habitacion

@{
    ViewData["Title"] = "Desactivar habitación";
}

<h1>Desactivar habitación</h1>

<div class="alert alert-warning">
    ¿Estás seguro de que deseas desactivar esta habitación?
    El registro permanecerá en la base de datos.
</div>

<dl class="row">
    <dt class="col-sm-3">Número</dt>
    <dd class="col-sm-9">@Model.Numero</dd>

    <dt class="col-sm-3">Piso</dt>
    <dd class="col-sm-9">@Model.Piso</dd>

    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Model.IdTipoHabitacionNavigation.Nombre</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.IdHabitacion" method="post">
    <button type="submit" class="btn btn-danger">Confirmar desactivación</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
